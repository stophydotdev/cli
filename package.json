{
  "name": "@stophy/cli",
  "version": "1.1.0",
  "description": "Web data for AI agents. Call the Stophy API from the terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stophy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://stophy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/cli.git"
  },
  "bugs": {
    "url": "https://github.com/stophydotdev/cli/issues"
  },
  "keywords": [
    "stophy",
    "web-data",
    "data-api",
    "cli",
    "ai-agent",
    "ai-agents",
    "llm",
    "search",
    "api"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch",
    "check": "biome check ./src",
    "check-types": "tsc --noEmit",
    "test": "bun test ./tests/account.test.ts ./tests/flags.test.ts ./tests/catalog.test.ts ./tests/commands.test.ts",
    "test:init": "npm run build && node --test tests/init.test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "build:binary": "bash scripts/build-binaries.sh",
    "build:binary:darwin": "bash scripts/build-binaries.sh darwin",
    "build:binary:linux": "bash scripts/build-binaries.sh linux",
    "build:binary:windows": "bash scripts/build-binaries.sh windows"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "conf": "^15.1.0",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "typescript": "^5.8.0"
  }
}
