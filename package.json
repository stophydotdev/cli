{
  "name": "@stophy/cli",
  "version": "2.0.4",
  "description": "The web data layer for AI agents, in your terminal. Live web data as typed JSON for AI agents. Search, video, social, jobs, places, property and ads behind one key, with a price shown before every call. You pay only for answers that come back.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stophy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://stophy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/cli.git"
  },
  "bugs": {
    "url": "https://github.com/stophydotdev/cli/issues"
  },
  "keywords": [
    "stophy",
    "cli",
    "web-data",
    "web-search",
    "scraping",
    "ai-agents",
    "llm",
    "youtube",
    "reddit",
    "maps",
    "mcp",
    "google-maps",
    "transcripts",
    "ads"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsc --watch",
    "check": "biome check ./src",
    "check-types": "tsc --noEmit",
    "test": "bun test ./tests/account.test.ts ./tests/login.test.ts ./tests/flags.test.ts ./tests/catalog.test.ts ./tests/commands.test.ts ./tests/init.test.ts ./tests/render.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "build:binary": "bash scripts/build-binaries.sh",
    "build:binary:darwin": "bash scripts/build-binaries.sh darwin",
    "build:binary:linux": "bash scripts/build-binaries.sh linux",
    "build:binary:windows": "bash scripts/build-binaries.sh windows"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "conf": "^15.1.0",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "typescript": "^5.8.0"
  }
}
